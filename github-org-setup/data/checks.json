      "availability": {"free": "free", "team": "free"},
      "read": {"only": "permissions"},
      "fix": {"kind": "manual"},
      "manual": "Add `permissions: contents: read` (or `read-all`) at the top of each workflow and give writes per job. Open a PR; run `ghsetup.py workflows <checkout>` to check.",
      "scorecard": ["Token-Permissions"],
      "source": [
