        "https://github.com/ossf/scorecard/blob/v5.6.0/docs/checks.md#license"
      ]
    },
    {
      "id": "REPO-WORKFLOW-TOKEN-PERMISSIONS",
      "scope": "repo",
      "title": "Every workflow has a top-level read-only `permissions:` block",
