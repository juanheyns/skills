      "fix": {"kind": "manual"},
      "manual": "Needs the owning teams. Add .github/CODEOWNERS; make /.github/ owned by the maintainers so workflow changes need their review. Then set require_code_owner_review=true in the ruleset.",
      "scorecard": ["Branch-Protection"],
      "source": [
