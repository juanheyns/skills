      "availability": {"free": "free", "team": "free"},
      "read": {"path": "/repos/{owner}/{repo}/automated-security-fixes", "pointer": "enabled"},
      "expect": {"value": true},
      "fix": {"kind": "api", "steps": [{"method": "PUT", "path": "/repos/{owner}/{repo}/automated-security-fixes"}]},
      "scorecard": ["Vulnerabilities", "Dependency-Update-Tool"],
